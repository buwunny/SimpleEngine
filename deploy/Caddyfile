{
    auto_https off
    admin off
}

:8080 {
    tls /tls/fullchain.pem /tls/privkey.pem

    encode zstd gzip

    handle /api/* {
        reverse_proxy control:8080
    }

    # Both matchers are needed: `/net/*` does NOT match a bare `/net`, and a
    # bare `/net` is exactly what clients connect to -- COW_PUBLIC_WS is
    # `wss://host/net`, with the room carried in the query string. With only
    # the wildcard, every real connection fell through to the 404 below.
    #
    # No handle_path here: the sidecar reads only the query string, never the
    # path, so stripping the prefix buys nothing and the un-stripped form is
    # the one that matches what the client asked for.
    @net path /net /net/*
    handle @net {
        # https://, because the sidecar terminates TLS on this port itself:
        # docker-compose.prod.yml hands it COW_TLS_CERT/COW_TLS_KEY (it needs
        # them for the WebTransport listener on :4443, which is exposed
        # directly), and its WS listener turns on TLS whenever those are set.
        # Proxying to it in plaintext is a handshake failure, i.e. a 502.
        #
        # Verification is skipped rather than pinned: this hop never leaves the
        # private `cownet` bridge, and Caddy dials the compose service name
        # `sidecar`, which no certificate issued for the public domain can
        # match. Pinning tls_server_name to the domain would work but bakes it
        # into an otherwise domain-agnostic file.
        reverse_proxy https://sidecar:8080 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    handle {
        respond "CowEngine backend" 404
    }
}